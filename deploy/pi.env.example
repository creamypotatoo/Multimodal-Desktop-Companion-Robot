# Copy to ~/.config/eli/pi.env and chmod 600. Use literal, unquoted values.
ELI_PI_AUDIO=pi
ELI_PI_AI=ollama
ELI_PI_MOTORS=mock
ELI_PI_CAMERA=1
ELI_PI_WAKE=1
ELI_PI_WAKE_PHRASE=Hey Eli
ELI_PI_ANNOUNCE=1
ELI_PI_HTTPS=0
ELI_WEB_PORT=5000

ELI_DISPLAY_BACKEND=tft
ELI_DISPLAY_FPS=10
ELI_TTS_BACKEND=espeak
ELI_TTS_DEVICE=plughw:CARD=MAX98357A,DEV=0
ELI_TTS_VOLUME=0.10
ELI_AUDIO_SAMPLE_RATE=16000
# ELI_AUDIO_INPUT=USB 2.0 Camera
# ELI_WHISPER_CPP_CLI=/absolute/path/to/whisper-cli
# ELI_WHISPER_CPP_MODEL=/absolute/path/to/ggml-tiny.bin

ELI_CAMERA_WIDTH=640
ELI_CAMERA_HEIGHT=480
ELI_CAMERA_FPS=8
ELI_CAMERA_PREVIEW_FPS=5
ELI_CAMERA_ANALYSIS_FPS=4
# ELI_FACE_MODEL=/absolute/private/path/trained_model.yml
# ELI_FACE_LABELS=/absolute/private/path/labels.txt
# ELI_SERIAL_PORT=/dev/serial/by-id/<your-ESP32>
ELI_SERIAL_BAUD=115200

# Enable this after starting the laptop-to-Pi SSH tunnel.
# ELI_OLLAMA_URL=http://127.0.0.1:11435
ELI_OLLAMA_MODEL=qwen3:1.7b
